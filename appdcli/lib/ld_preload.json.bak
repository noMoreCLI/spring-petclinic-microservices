{
  "logging": {
    "level": "trace",
    "directory": "/var/log/appdynamics",
    "fileName": "ld_preload.log",
    "usePid": true
  },
  "java": {
    "agentPath": "/opt/appdynamics/java-agent/javaagent.jar",
    "instrument": true,
    "filters": [
      {
        "name": "petclinic-1",
        "regex": ".*java.*-jar.*\\.jar.*",
        "instrument": true,
        "applicationName": "Petclinic-1",
        "tierName": "Petclinic-Tier",
        "nodeName": "Petclinic-Node"
      }
    ]
  }
}
