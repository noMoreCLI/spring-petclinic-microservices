{
  "logging": {
    "level": "trace",
    "directory": "/opt/appdynamics/appdsmartagent",
    "fileName": "ld_preload.log",
    "usePid": true
  },
  "java": {
    "agentPath": "/opt/appdynamics/java-agent/javaagent.jar",
    "instrument": true,
    "filters": [
      {
        "name": "springboot jar",
        "regex": "java.*-jar\\s+.*\\.jar.*spring\\.profiles\\.active=.*",
        "instrument": true
      },
      {
        "name": "ignore java version help",
        "regex": "-version|--help",
        "instrument": false,
        "uninstrumentable": true
      },
      {
        "name": "ignore java agent proxy",
        "regex": ".*appdynamics_bindeps.*",
        "instrument": false
      },
      {
        "name": "tomcat",
        "regex": ".*java.*tomcat.*catalina.*org\\.apache\\.catalina\\.startup\\.Bootstrap.*start.*",
        "instrument": true
      },
      {
        "name": "glassfish",
        "regex": ".*java.*glassfish.*com\\.sun\\.enterprise\\.glassfish\\.bootstrap\\.ASMain.*start.*",
        "instrument": true,
        "systemProperties": {
          "org.osgi.framework.bootdelegation": "com.singularity.*"
        }
      },
      {
        "name": "springboot",
        "regex": "spring\\.profiles\\.active",
        "instrument": true
      },
      {
        "name": "jboss",
        "regex": ".*java.*wildfly|org.jboss\\.as\\.standalone|jboss\\.http\\.port=|jboss\\.server\\.base\\.dir",
        "instrument": true,
        "systemProperties": {
          "jboss.modules.system.pkgs": "org.jboss.byteman,com.singularity"
        }
      },
      {
        "name": "weblogic",
        "regex": "Dweblogic.Nameweblogic.Name=|Dweblogic.home|weblogic.Server",
        "instrument": true
      },
      {
        "name": "websphere",
        "regex": "Dwas.install.root=|com\\.ibm\\.ws\\.bootstrap\\.WSLauncher",
        "instrument": true
      },
      {
        "name": "machineagent",
        "regex": ".*machineagent.*",
        "instrument": false
      },
      {
        "name": "plain java",
        "regex": "java",
        "instrument": true
      },
      {
        "name": "wildcard",
        "regex": ".*",
        "instrument": false,
        "uninstrumentable": true
      }
    ]
  },
  "nodejs": {
    "agentPath": "/opt/appdynamics/nodejs-agent/appd-config.js",
    "instrument": true,
    "filters": [
      {
        "name": "ignore npm commands",
        "regex": "npm",
        "instrument": false
      },
      {
        "name": "ignore preinstall script",
        "regex": "node preInstallScript.js",
        "instrument": false
      },
      {
        "name": "ignore install script",
        "regex": "node install.js appdynamics*",
        "instrument": false
      },
      {
        "name": "instrument node applications",
        "regex": "node .*\\.js.*$",
        "instrument": true
      },
      {
        "name": "wildcard",
        "regex": ".*",
        "instrument": false,
        "uninstrumentable": true
      }
    ]
  },
  "python3": {
    "agentPath": "/opt/appdynamics/python-agent/appd.cfg",
    "instrument": true,
    "filters": [
      {
        "name": "ignore python help",
        "regex": ".*[Pp]ython[23]?(\\.\\d+)?\\s+(-h|--help)$",
        "instrument": false,
        "uninstrumentable": true
      },
      {
        "name": "ignore pip help",
        "regex": ".*pip[23]?(\\s+(-h|--help))$",
        "instrument": false,
        "uninstrumentable": true
      },
      {
        "name": "instrument python applications",
        "regex": ".*[Pp]ython[23]?(\\.\\d+)?\\s.*\\.py",
        "instrument": true
      },
      {
        "name": "instrument pip applications",
        "regex": ".*pip[23]?\\s",
        "instrument": true
      },
      {
        "name": "instrument pip applications running via python",
        "regex": ".*[Pp]ython[23]?(\\.\\d+)?\\s-m\\s+pip[23]?\\s",
        "instrument": true
      },
      {
        "name": "wildcard",
        "regex": ".*",
        "instrument": false,
        "uninstrumentable": true
      }
    ]
  },
  "php": {
    "agentPath": "/opt/appdynamics/php-agent/php-agent.tar.bz2",
    "instrument": true,
    "filters": [
      {
        "name": "ignore php help",
        "regex": ".*php[5-8]?(\\.\\d+)?\\s+(-h|--help)$",
        "instrument": true,
        "uninstrumentable": true
      },
      {
        "name": "instrument php applications",
        "regex": ".*php[5-8]?(\\.\\d+)?\\s.*\\.php",
        "instrument": true
      },
      {
        "name": "instrument php modules",
        "regex": ".*php[5-8]?(\\.\\d+)?\\s-m\\s",
        "instrument": true
      },
      {
        "name": "instrument Laravel's Artisan tool",
        "regex": "php\\sartisan",
        "instrument": true
      },
      {
        "name": "wildcard",
        "regex": "*",
        "instrument": false,
        "uninstrumentable": true
      }
    ]
  }
}
